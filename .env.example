# ── Discord ───────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=your-bot-token-here

# Comma-separated channel IDs the bot is allowed to talk in.
# Leave empty to allow every channel the bot can see.
# (Enable Developer Mode in Discord → right-click a channel → Copy Channel ID)
ALLOWED_CHANNELS=

# How the bot decides to respond:
#   channel = reply to every message in ALLOWED_CHANNEL_IDS (whole-channel)
#   mention = reply only when @mentioned or DMed
TRIGGER_MODE=channel

# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# qwen2.5:3b — fast (~3-4s warm) and stable on a 4GB GPU. qwen3:4b also works but
# force-reasons (slow, 40-100s). llama3.2:3b crashes the runner on a GTX 960M.
OLLAMA_MODEL=qwen2.5:3b

# Keep the model loaded in memory between messages (avoids slow cold reloads).
# e.g. 30m, 1h, or -1 to keep it loaded indefinitely.
OLLAMA_KEEP_ALIVE=30m

# Append /no_think to suppress visible chain-of-thought. Leave UNSET to auto-detect
# (on only for qwen3); set true/false to force it for a specific model.
# DISABLE_THINKING=true

# ── Generation ────────────────────────────────────────────────────────────
TEMPERATURE=0.85
TOP_P=0.9
REPEAT_PENALTY=1.1
NUM_CTX=4096

# Max tokens per generation. NOTE: qwen3's hidden "thinking" tokens count against
# this too, so keep it generous (>=300) or replies come back empty. Lower = faster.
MAX_TOKENS=384

# Number of conversation turns (user+bot pairs) kept per channel as context.
HISTORY_TURNS=8

# Per-request timeout (seconds) for the Ollama call.
OLLAMA_TIMEOUT=120

# ── Memory ────────────────────────────────────────────────────────────────
# Where per-channel memory (transcript + facts + summary) is persisted.
MEMORY_DIR=memory/data
# Refresh the distilled facts/summary after this many new user turns (1 extra
# LLM call each time, run in the background).
MEMORY_SUMMARY_EVERY=6

# ── Proactivity ───────────────────────────────────────────────────────────
# Let Pariston speak unprompted to revive a quiet channel.
PROACTIVE_ENABLED=true
# Re-engage only after a channel that had a real exchange goes quiet this long.
IDLE_MINUTES=8
# Minimum minutes between two proactive messages in the same channel.
PROACTIVE_COOLDOWN_MINUTES=30
# Hard ceiling on proactive messages per channel per rolling hour.
PROACTIVE_MAX_PER_HOUR=2
# How often (seconds) the background loop checks for idle channels.
PROACTIVE_CHECK_SECONDS=60
